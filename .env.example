# Session signing secret (required in production)
AUTH_SECRET=replace-with-a-long-random-string

# Optional: Vercel Blob for writable persistence on Vercel
# When unset, local data/gwpm.json + public/uploads are used.
# BLOB_READ_WRITE_TOKEN=

# Supabase (multi-tenant Postgres). The app connects only when BOTH
# NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are non-empty.
# Until then it keeps JSON / Blob and the live database is not connected.
#
# Where to set real values (never commit them, never paste them into a PR):
#   Vercel: gwpm → Settings → Environment Variables (Production and Preview), then redeploy
#   Local:  .env.local  (cp .env.example .env.local)
#
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
#
# Optional. Not read by the server data layer. RLS denies the anon key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# Optional. Direct Postgres URL for psql / SQL tools. The Next.js app does not read it.
# DATABASE_URL=
