# Session signing secret (required in production)
AUTH_SECRET=replace-with-a-long-random-string

# Optional: Vercel Blob for writable persistence on Vercel
# When unset, local data/gwpm.json + public/uploads are used.
# BLOB_READ_WRITE_TOKEN=

# Optional: Supabase (multi-tenant Postgres) — recommended for multi-company production
# Create project, run supabase/schema.sql, then set:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=
